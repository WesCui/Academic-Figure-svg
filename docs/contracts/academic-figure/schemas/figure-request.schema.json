{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:academic-figure:contract:figure-request:1.0",
  "title": "Figure Request Contract",
  "description": "Normalized task-level request for creating or revising an academic figure.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "mode",
    "instruction",
    "interactionMode",
    "output"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "urn:academic-figure:contract:common:1.0#/$defs/SchemaVersion"
    },
    "requestId": {
      "$ref": "urn:academic-figure:contract:common:1.0#/$defs/Identifier"
    },
    "operationId": {
      "$ref": "urn:academic-figure:contract:common:1.0#/$defs/OperationId"
    },
    "mode": {
      "type": "string",
      "enum": [
        "create",
        "revise"
      ]
    },
    "instruction": {
      "$ref": "urn:academic-figure:contract:common:1.0#/$defs/NonEmptyString"
    },
    "interactionMode": {
      "type": "string",
      "enum": [
        "auto",
        "plan-confirmation"
      ]
    },
    "actor": {
      "$ref": "urn:academic-figure:contract:common:1.0#/$defs/Actor"
    },
    "sourceContext": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "files": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:academic-figure:contract:common:1.0#/$defs/PathString"
          }
        },
        "paperSections": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:academic-figure:contract:common:1.0#/$defs/NonEmptyString"
          }
        },
        "codeDirectories": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "urn:academic-figure:contract:common:1.0#/$defs/PathString"
          }
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId"
      ],
      "properties": {
        "documentId": {
          "$ref": "urn:academic-figure:contract:common:1.0#/$defs/DocumentId"
        },
        "expectedRevision": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "reference": {
      "$ref": "urn:academic-figure:contract:common:1.0#/$defs/ReferenceSelection"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "documentId": {
          "$ref": "urn:academic-figure:contract:common:1.0#/$defs/DocumentId"
        },
        "name": {
          "$ref": "urn:academic-figure:contract:common:1.0#/$defs/NonEmptyString"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "exportPath": {
          "$ref": "urn:academic-figure:contract:common:1.0#/$defs/PathString"
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "svg",
              "png"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "revise"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "required": [
              "documentId",
              "expectedRevision"
            ]
          }
        }
      }
    }
  ]
}
